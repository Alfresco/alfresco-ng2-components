{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "baseUrl": "../../",
    "paths": {
      "@alfresco/js-api": ["lib/js-api/src/index.ts"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "exclude": [],
  "include": ["**/*"]
}
